{
  "manifest_version": 3,
  "name": "Micnaga - senal de llamada de Meet",
  "short_name": "Micnaga",
  "version": "0.1.0",
  "description": "Avisa a la app local Micnaga de que estas en una llamada de Google Meet. Sin red, sin analitica.",
  "key": "",
  "minimum_chrome_version": "105",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://meet.google.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["detect.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
